# ------------------------------------------------------------------------------
# 6. Explicitly Retain Submission Deliverables
# ------------------------------------------------------------------------------
!src/
!app.py
!data/
!data/**
!artifacts/
!artifacts/**
!figures/
!figures/**
!requirements.txt
!README.md
!pyproject.toml
!pyrefly.toml

