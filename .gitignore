*.nav
*.snm
*.vrb
*.idx
*.ilg
*.ind
*.glo
*.gls
*.glg
*.ist
*.upa
*.upb

# Ensure report.tex and report.pdf remain tracked
!report.tex
!report.pdf

# ------------------------------------------------------------------------------
# 5. OS & Editor / Agent Metadata
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Settings
.vscode/
**/.vscode/
.idea/
**/.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Agent / Tool Specific Metadata
.gemini/
**/.gemini/
.antigravity/
